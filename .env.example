# Postgres connection (local: docker compose up -d)
DATABASE_URL=postgres://lab:lab@localhost:5432/access_lab
# Used only by `npm test`; the test run wipes this database.
TEST_DATABASE_URL=postgres://lab:lab@localhost:5432/access_lab_test

# Public base URL (your cloudflared/ngrok tunnel). Used for SCIM meta.location.
APP_BASE_URL=http://localhost:3000

# Shared secret Okta/Entra send as "Authorization: Bearer <token>".
# Generate with: openssl rand -hex 32
SCIM_BEARER_TOKEN=change-me

# --- SAML (Phase 2). Values come from the Okta app's "View SAML setup instructions". ---
# Our SP entity ID; must equal Okta's "Audience URI (SP Entity ID)".
SAML_SP_ENTITY_ID=http://localhost:3000/auth/saml/metadata
# Okta's "Identity Provider Single Sign-On URL".
SAML_ENTRY_POINT=https://dev-000000.okta.com/app/dev-000000_accesslab_1/exk000000/sso/saml
# Okta's "X.509 Certificate" (PEM). Use \n for line breaks on a single line.
SAML_IDP_CERT="-----BEGIN CERTIFICATE-----\nMIID...\n-----END CERTIFICATE-----"
# Attribute statement names configured in Okta.
SAML_EMAIL_ATTRIBUTE=email
SAML_GROUPS_ATTRIBUTE=groups
SESSION_TTL_HOURS=8

# --- Claude (Phase 3) ---
ANTHROPIC_API_KEY=sk-ant-...
# Defaults to claude-opus-5-5.
# CLAUDE_MODEL=claude-opus-5-5
# Optional remote MCP server, attached only for roles with the connector:docs capability.
# MCP_DOCS_URL=https://your-mcp-server.example.com/mcp
# MCP_DOCS_TOKEN=
